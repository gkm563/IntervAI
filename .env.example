# =============================================================================
# IntervAI Platform — Environment Configuration (.env.example)
# =============================================================================

# --- Core Backend ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase / Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervai_db
DB_SSL=false

# Authentication Secrets (Generate 32-byte hex/base64 strings for production)
JWT_ACCESS_SECRET=intervai_dev_access_secret_change_in_production_key_32bytes
JWT_REFRESH_SECRET=intervai_dev_refresh_secret_change_in_production_key_32bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email Verification (Resend / SMTP / Console Logger)
# 'console' prints codes and reset URLs directly into dev terminal for zero friction
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=IntervAI <auth@intervai.com>

# --- AI Microservice ---
AI_SERVICE_PORT=8000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Frontend Web Client ---
VITE_API_URL=http://localhost:4000
