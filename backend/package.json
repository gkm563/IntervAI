{
  "name": "intervai-backend",
  "version": "1.0.0",
  "description": "IntervAI Core Backend Service - Authentication, User Management, and Relational Data",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
