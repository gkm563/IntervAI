# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase / Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervai_db
DB_SSL=false

# Authentication & JWT Secrets
# Run `openssl rand -base64 32` to generate secure secrets
JWT_ACCESS_SECRET=intervai_dev_access_secret_change_in_production_key_32bytes
JWT_REFRESH_SECRET=intervai_dev_refresh_secret_change_in_production_key_32bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email Provider Configuration (Resend / SMTP / Brevo)
# If left empty, codes and reset links will log to the server console for zero-cost dev
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=IntervAI <auth@intervai.com>

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
